# ---------------------------------------------------------------------------
# Innovations Rental Solutions environment configuration
# Copy this file to .env and adjust values. Never commit .env.
# ---------------------------------------------------------------------------

# Database (SQLite by default for zero-config local development)
DATABASE_URL="file:./dev.db"

# Authentication — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
AUTH_COOKIE_NAME="innovations_session"
AUTH_SESSION_DAYS=7
# Failed/successful sign-in attempts allowed per IP per 10 minutes. Raise only
# for load tests or shared-IP environments.
AUTH_LOGIN_IP_LIMIT="10"
# Per-account sign-in attempts per 10 minutes (default 8).
# AUTH_LOGIN_EMAIL_LIMIT="8"
# Form throttles: inquiries per IP per 10 minutes and site visits per 15 minutes.
# LEAD_RATE_LIMIT="6"
# SITE_VISIT_RATE_LIMIT="5"

# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed admin account (created by `npm run db:seed`)
SEED_ADMIN_NAME="Innovations Admin"
SEED_ADMIN_EMAIL="admin@innovations.demo"
SEED_ADMIN_PASSWORD="Admin@12345"

# Optional AI provider. The assistant works fully without these keys using a
# deterministic, database-grounded intent parser. When configured, the provider
# is used only to parse intent — project facts always come from the database.
# Compatible with OpenAI, Groq, Together, OpenRouter, Ollama, etc.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_PROVIDER="auto" # auto | openai-compatible | rules

# Optional S3-compatible cloud storage. If unset, uploads are written to
# storage/uploads and served through /media/<key>. Use S3 (or another shared
# volume) for serverless or multi-instance production deployments.
STORAGE_DRIVER="local" # local | s3
UPLOAD_DIR="" # optional absolute path for local uploads
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# Optional WhatsApp number in international format without + (used in CTA links)
NEXT_PUBLIC_WHATSAPP_NUMBER="919999999999"
NEXT_PUBLIC_SALES_PHONE="+91 99999 99999"
NEXT_PUBLIC_SALES_EMAIL="hello@innovations.demo"
